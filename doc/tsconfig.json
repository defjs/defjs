{
  "extends": "../tsconfig.base.json",
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "*.ts",
    ".react-router/types/**/*.ts",
    "test/**/*.tsx",
    "e2e/**/*.tsx",
    "examples/opentelemetry-logging/**/*.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["bun", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./app/*"],
      "@defjs/core": ["../packages/core/src"],
      "@defjs/react": ["../packages/react/src"],
      "@defjs/vue": ["../packages/vue/src"],
      "@defjs/opentelemetry-server": ["../packages/opentelemetry-server/src"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true
  }
}
