index e4ba18e..0cee18b 100644
--- a/packages/core/src/client/client.ts
+++ b/packages/core/src/client/client.ts
@@ -1,12 +1,11 @@
-import type { Command } from './command'
-import { isEventStreamCommand, isHttpCommand, isWebSocketCommand } from './command'
+import type { Command, CommandExecutor } from './command'
+import { COMMAND_EXECUTE, isEventStreamCommand, isHttpCommand, isWebSocketCommand } from './command'
 import type { ClientConfig } from './config'
 import { createClientConfig } from './config'
 import type { ClientOption } from './option'
 import type { HttpCommand, HttpExecuteOptions } from '../http/http'
-import { executeHttpCommand } from '../http/http'
+import type { executeHttpCommand } from '../http/http'
 import type { EventStructs, EventStreamCommand, EventStreamData, EventStreamExecuteOptions, StreamAwaitResult } from '../sse/sse'
-import { executeEventStreamCommand } from '../sse/sse'
 import type { AnyStruct } from '../struct'
 import type {
   SocketAwaitResult,
@@ -15,7 +14,6 @@ import type {
   WebSocketIncomingData,
   WebSocketOutgoingData,
 } from '../web_socket/web_socket'
-import { executeWebSocketCommand } from '../web_socket/web_socket'
 
 export const CLIENT = Symbol('Client')
 
@@ -77,19 +75,11 @@ export function createClient(...options: ClientOption[]): Client {
     options?: HttpExecuteOptions,
   ): ReturnType<typeof executeHttpCommand<TInput, TOutput, TError>>
   function execute(command: Command, options?: unknown): Promise<unknown> {
-    if (isHttpCommand(command)) {
-      return executeHttpCommand(conf, command, options as HttpExecuteOptions | undefined)
-    }
-
-    if (isEventStreamCommand(command)) {
-      return executeEventStreamCommand(conf, command, options as EventStreamExecuteOptions | undefined)
-    }
-
-    if (isWebSocketCommand(command)) {
-      return executeWebSocketCommand(
+    if (isHttpCommand(command) || isEventStreamCommand(command) || isWebSocketCommand(command)) {
+      return (command[COMMAND_EXECUTE] as (config: ClientConfig, command: Command, options: unknown) => ReturnType<CommandExecutor>)(
         conf,
         command,
-        options as WebSocketExecuteOptions<WebSocketIncomingData<AnyStruct>, WebSocketOutgoingData<AnyStruct | undefined>> | undefined,
+        options,
       )
     }
 
diff --git a/packages/core/src/client/command.ts b/packages/core/src/client/command.ts
index 82d3fa4..f3634bd 100644
--- a/packages/core/src/client/command.ts
+++ b/packages/core/src/client/command.ts
@@ -1,3 +1,4 @@
+import type { ClientConfig } from './config'
 import type { HttpCommand } from '../http/http'
 import type { EventStructs, EventStreamCommand } from '../sse/sse'
 import type { AnyStruct } from '../struct'
@@ -7,10 +8,15 @@ export const COMMAND_TYPE: unique symbol = Symbol.for('defjs.command.type')
 export const HTTP_COMMAND: unique symbol = Symbol.for('defjs.command.http')
 export const EVENT_STREAM_COMMAND: unique symbol = Symbol.for('defjs.command.event-stream')
 export const WEB_SOCKET_COMMAND: unique symbol = Symbol.for('defjs.command.web-socket')
+/** The command's own runner, so `client.execute` never imports a transport the app does not use. */
+export const COMMAND_EXECUTE: unique symbol = Symbol.for('defjs.command.execute')
+
+export type CommandExecutor = (config: ClientConfig, command: never, options?: never) => Promise<unknown>
 
 export type CommandType = typeof HTTP_COMMAND | typeof EVENT_STREAM_COMMAND | typeof WEB_SOCKET_COMMAND
 
 export interface BaseCommand<TCommandType extends CommandType> {
+  readonly [COMMAND_EXECUTE]: CommandExecutor
   readonly [COMMAND_TYPE]: TCommandType
 }
 
