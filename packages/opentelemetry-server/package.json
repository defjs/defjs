{
  "name": "@defjs/opentelemetry-server",
  "version": "0.0.4",
  "description": "Append OpenTelemetry interceptors to an application-owned Defjs client.",
  "bugs": {
    "url": "https://github.com/defjs/defjs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defjs/defjs.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun check --project tsconfig.build.json && bun --bun tsdown --config-loader native --config tsdown.config.ts",
    "unit:bun": "vitest run --config vitest.config.bun.ts",
    "unit:node": "vitest run --config vitest.config.node.ts"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.223.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@vitest/coverage-istanbul": "^5.1.0",
    "hono": "^4.13.17",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-dev.20261109.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@defjs/core": "^0.7.0",
    "@opentelemetry/api": "^1.0.0",
    "@opentelemetry/core": "^2.0.0 || ^3.0.0"
  }
}
