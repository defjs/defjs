{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "test",
    "src/**/*.spec.ts",
    "src/**/*.type.test.ts",
    "src/**/*.bench.ts"
  ]
}
