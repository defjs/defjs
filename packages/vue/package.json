{
  "name": "@defjs/vue",
  "version": "0.0.5",
  "description": "Provide an existing Defjs client to a Vue application.",
  "bugs": {
    "url": "https://github.com/defjs/defjs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defjs/defjs.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun check --project tsconfig.build.json && bun --bun tsdown --config-loader native --config tsdown.config.ts",
    "unit:chrome": "vitest run --config vitest.config.chrome.ts",
    "unit:firefox": "vitest run --config vitest.config.firefox.ts"
  },
  "devDependencies": {
    "@defjs/core": "workspace:^",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "3.5.45"
  },
  "peerDependencies": {
    "@defjs/core": "^0.8.0",
    "vue": ">=3.0.0"
  }
}
