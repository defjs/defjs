{
  "name": "@defjs/react",
  "version": "0.0.4",
  "description": "Provide an existing Defjs client to a React tree.",
  "bugs": {
    "url": "https://github.com/defjs/defjs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defjs/defjs.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun --bun tsdown --config-loader native --config tsdown.config.ts",
    "unit:chrome": "vitest run --config vitest.config.chrome.ts",
    "unit:firefox": "vitest run --config vitest.config.firefox.ts"
  },
  "devDependencies": {
    "@defjs/core": "workspace:^",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "playwright": "catalog:",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@defjs/core": "^0.7.0",
    "react": ">=18.0.0"
  }
}
