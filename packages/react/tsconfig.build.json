{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "types": [],
    "paths": {
      "@defjs/core": ["../core/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["test", "src/**/*.spec.ts", "src/**/*.type.test.ts", "src/**/*.browser.spec.ts"]
}
