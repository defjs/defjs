{
  "name": "@defjs/cli",
  "version": "0.1.0",
  "description": "Development-time CLI and OpenAPI code generator for Defjs.",
  "bugs": {
    "url": "https://github.com/defjs/defjs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defjs/defjs.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "defjs": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "bun check --project tsconfig.build.json && bun --bun tsdown --config-loader native --config tsdown.config.ts",
    "unit:bun": "vitest run --config vitest.config.bun.ts",
    "unit:node": "vitest run --config vitest.config.node.ts"
  },
  "devDependencies": {
    "@scalar/openapi-parser": "0.29.27",
    "@stricli/core": "^1.3.0",
    "@types/node": "^26.3.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "es-toolkit": "^1.53.2",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-dev.20261124.1",
    "valibot": "^1.5.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@defjs/core": "^0.9.0"
  },
  "peerDependenciesMeta": {
    "@defjs/core": {
      "optional": true
    }
  }
}
