{
  "name": "defjs",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "doc"
    ],
    "catalog": {
      "@hono/node-server": "^2.1.1",
      "@hono/node-ws": "^1.3.1",
      "@types/bun": "1.4.2",
      "@vitest/browser": "^5.0.0",
      "@vitest/browser-playwright": "^5.0.2",
      "@vitest/coverage-istanbul": "^5.0.2",
      "hono": "^4.13.10",
      "oxfmt": "0.71.0",
      "oxlint": "1.86.0",
      "oxlint-tsgolint": "7.0.2003",
      "playwright": "^1.63.0",
      "tsdown": "^0.23.0",
      "typescript": "^7.0.2",
      "vite": "^8.3.1",
      "vitest": "^5.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && bun run --workspaces --if-present build",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "bun run --sequential --workspaces --if-present test",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify": "bun run lint && bun run fmt:check && bun run test && bun run build"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@types/bun": "catalog:",
    "hono": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "vite": "^8.3.1"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
