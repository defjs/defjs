{
  "name": "defjs",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "doc"
    ],
    "catalog": {
      "@hono/node-server": "^2.1.5",
      "@types/bun": "1.4.4",
      "@types/ws": "^8.18.2",
      "@vitest/browser": "^5.0.5",
      "@vitest/browser-playwright": "^5.0.5",
      "@vitest/coverage-istanbul": "^5.0.5",
      "hono": "^4.13.14",
      "oxlint": "1.90.0",
      "oxlint-tsgolint": "7.0.2005",
      "playwright": "^1.64.1",
      "tsdown": "^0.23.3",
      "typescript": "7.1.0-beta",
      "vite": "^8.3.5",
      "vitest": "^5.0.5",
      "ws": "^8.22.0",
      "fumadocs-core": "16.17.8",
      "fumadocs-typescript": "5.6.0",
      "fumadocs-ui": "16.17.8",
      "fumadocs-mdx": "15.4.10",
      "react-router": "8.5.1",
      "@react-router/dev": "8.5.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@types/mdx": "2.0.14",
      "tailwindcss": "4.3.3",
      "@tailwindcss/vite": "4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test:unit": "bun run --sequential --workspaces --if-present test:unit && bun test ./test",
    "test:e2e": "bun run --sequential --workspaces --if-present test:e2e",
    "typecheck": "bun check --project tsconfig.json && bun run --cwd doc typecheck"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@types/bun": "catalog:",
    "hono": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "rolldown-plugin-dts": "0.29.0-beta.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
