{
  "name": "defjs",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "doc"
    ],
    "catalog": {
      "@types/bun": "1.4.4",
      "@vitest/browser": "^5.1.0",
      "@vitest/browser-playwright": "^5.1.0",
      "@vitest/coverage-istanbul": "^5.1.0",
      "hono": "^4.13.16",
      "@hono/bun": "^1.0.1",
      "@hono/node-server": "^2.1.6",
      "ws": "^8.22.1",
      "@types/ws": "^8.18.2",
      "playwright": "^1.64.1",
      "tsdown": "^0.23.5",
      "typescript": "7.1.0-beta",
      "vite": "^8.3.5",
      "vitest": "^5.1.0",
      "fumadocs-core": "16.17.10",
      "fumadocs-ui": "16.17.10",
      "fumadocs-mdx": "15.4.10",
      "react-router": "8.5.1",
      "@react-router/dev": "8.5.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@types/mdx": "2.0.14",
      "tailwindcss": "4.3.4",
      "@tailwindcss/vite": "4.3.4"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "unit:chrome": "bun run --sequential --workspaces --if-present unit:chrome",
    "unit:firefox": "bun run --sequential --workspaces --if-present unit:firefox",
    "unit:bun": "bun run --sequential --workspaces --if-present unit:bun && vitest run --config vitest.config.bun.ts",
    "unit:node": "node test/unit-node.ts",
    "test:unit": "bun run unit:chrome && bun run unit:firefox && node --run unit:node && bun run unit:bun",
    "test:e2e": "bun run --sequential --workspaces --if-present test:e2e",
    "typecheck": "bun check --project tsconfig.json && bun run --cwd doc typecheck"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.10",
    "hono": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
